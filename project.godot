; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MTW Remake"
config/description="Remake della campagna di Medieval: Total War con la XL 3.0 e la mod Auror, dal 1000 al 1700."
; ADR-144: versione del gioco, confrontata con il tag dell'ultima release su GitHub (UpdateCheck); aggiornarla a ogni
; rilascio, uguale a --versione di installer/prepara_installer.py (che la controlla)
config/version="2026.11.27.1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icona.png"
config/windows_native_icon="res://assets/icona.ico"
; 26/11/2026: tetto a 60 fotogrammi (con la sincronia verticale il default e' la frequenza dello schermo): meno CPU
; occupata dal disegno, piu' margine al thread dell'audio
run/max_fps=60

[audio]

; vale solo se Windows non concede la modalita' a bassa latenza: con IAudioClient3 WASAPI usa il periodo minimo del
; dispositivo (10 ms sul PC di Federico, misurato da AudioMonitor il 25/11/2026)
driver/output_latency=60

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=2

[threading]

; al massimo 8 thread di lavoro (predefinito: tutti i core), per lasciare la CPU libera al thread dell'audio: con un
; buffer da 10 ms la musica salta se quel thread aspetta (richiesta di Federico del 25/11/2026, prova)
worker_pool/max_threads=8
